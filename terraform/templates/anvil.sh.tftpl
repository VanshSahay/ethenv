#!/bin/bash
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y docker.io
systemctl enable --now docker

mkdir -p /eth

cat > /eth/boot.sh <<'BOOT'
#!/bin/bash
set -euxo pipefail

docker rm -f anvil 2>/dev/null || true

docker run -d --name anvil --restart unless-stopped --network host \
  --entrypoint anvil \
  ghcr.io/foundry-rs/foundry:latest \
  --host 0.0.0.0 \
  --port 8545 \
  --chain-id ${chain_id} \
  --block-time 2
BOOT
chmod +x /eth/boot.sh

cat > /etc/systemd/system/ethnode.service <<'UNIT'
[Unit]
Description=ethenv Ethereum node boot
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
TimeoutStartSec=0
ExecStart=/eth/boot.sh
RemainAfterExit=yes
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
UNIT

systemctl enable --now ethnode
